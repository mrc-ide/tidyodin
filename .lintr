linters: linters_with_defaults(
    indentation_linter = NULL,
    object_length_linter = NULL,
    object_usage_linter = NULL
    )
exclusions: list(
    "tests/testthat.R",
    "tests/testthat/helper-models.R" = list(object_name_linter = Inf),
    "vignettes" = list(object_name_linter = Inf)
    )
